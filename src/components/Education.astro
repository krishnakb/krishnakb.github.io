---
import resume from '../data/resume.json';
---

<section id="education">
  <div class="container">
    <h2 class="section-header">education</h2>

    <div class="education-grid">
      {resume.education.map((edu) => (
        <div class="terminal education-card">
          <div class="terminal-header">
            <div class="terminal-dot red"></div>
            <div class="terminal-dot yellow"></div>
            <div class="terminal-dot green"></div>
            <span class="terminal-title">education.json</span>
          </div>
          <div class="terminal-body">
            <pre class="code-block"><span class="punctuation">{'{'}</span>
  <span class="key">"institution"</span>: <span class="string">"{edu.institution}"</span>,
  <span class="key">"degree"</span>: <span class="string">"{edu.degree}"</span>,
  <span class="key">"location"</span>: <span class="string">"{edu.location}"</span>,
  <span class="key">"period"</span>: <span class="string">"{edu.startDate} - {edu.endDate}"</span>
<span class="punctuation">{'}'}</span></pre>
          </div>
        </div>
      ))}
    </div>

    <div class="languages-section">
      <h3 class="subsection-header">languages</h3>
      <div class="languages-grid">
        {resume.languages.map((lang) => (
          <div class="language-item">
            <span class="lang-name">{lang.name}</span>
            <span class="lang-level">{lang.level}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .education-grid {
    display: grid;
    gap: 24px;
    margin-bottom: 48px;
  }

  .education-card {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  section.visible .education-card {
    opacity: 1;
    transform: translateY(0);
  }

  .code-block {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.8;
    white-space: pre-wrap;
  }

  .punctuation { color: var(--text); }
  .key { color: var(--blue); }
  .string { color: var(--orange); }

  .subsection-header {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--text-bright);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .subsection-header::before {
    content: '>';
    color: var(--green);
  }

  .languages-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .language-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px 24px;
    text-align: center;
    transition: border-color 0.2s, transform 0.2s;
    opacity: 0;
    transform: translateY(20px);
  }

  section.visible .language-item {
    opacity: 1;
    transform: translateY(0);
  }

  section.visible .language-item:nth-child(1) { transition-delay: 0.3s; }
  section.visible .language-item:nth-child(2) { transition-delay: 0.4s; }
  section.visible .language-item:nth-child(3) { transition-delay: 0.5s; }
  section.visible .language-item:nth-child(4) { transition-delay: 0.6s; }

  .language-item:hover {
    border-color: var(--teal);
    transform: translateY(-2px);
  }

  .lang-name {
    display: block;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-bright);
    margin-bottom: 4px;
  }

  .lang-level {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .code-block {
      font-size: 0.8rem;
    }

    .terminal-body {
      padding: 16px;
    }
  }
</style>
